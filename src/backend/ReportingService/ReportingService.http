@ReportingService_HostAddress = http://localhost:5270

@requestedBy = 3fa85f64-5717-4562-b3fc-2c963f66afa6
# Copy the "id" returned by POST /reports/safety into @reportJobId to query and download it.
@reportJobId = 7c9e6679-7425-40de-944b-e07fc1f90ae7

GET {{ReportingService_HostAddress}}/api/v1/report-definitions?onlyActive=true
Accept: application/json

###

POST {{ReportingService_HostAddress}}/api/v1/report-definitions
Content-Type: application/json

{
  "code": "fatigue-by-shift",
  "name": "Fatigue alerts by shift",
  "version": "v1.0",
  "dataSources": ["fatigue-assessments", "alerts"]
}

###

POST {{ReportingService_HostAddress}}/api/v1/reports/safety
Content-Type: application/json

{
  "from": "2026-10-01T00:00:00Z",
  "to": "2026-10-14T00:00:00Z",
  "siteId": "site-north",
  "fleetId": "fleet-a",
  "definitionCode": "fatigue-by-shift",
  "format": "Pdf",
  "requestedBy": "{{requestedBy}}"
}

###

GET {{ReportingService_HostAddress}}/api/v1/reports?siteId=site-north&page=1&pageSize=20
Accept: application/json

###

GET {{ReportingService_HostAddress}}/api/v1/reports/{{reportJobId}}
Accept: application/json

###

GET {{ReportingService_HostAddress}}/api/v1/reports/{{reportJobId}}/download
Accept: application/pdf

###
