<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Integration tests with third-party services (section 4.4.2). The Reporting Service talks to
    Amazon SQS and Amazon S3 with the real AWS SDK; here those calls run against LocalStack in a
    container (Testcontainers), so the requests, serialization and error codes of the AWS APIs are
    exercised without an AWS account. Requires Docker: workflow third-party-integration.yml.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>MineSenseSafety.ThirdPartyIntegrationTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="Testcontainers.LocalStack" Version="4.7.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\ReportingService\ReportingService.csproj" />
  </ItemGroup>

</Project>
