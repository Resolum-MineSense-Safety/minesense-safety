<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Automated acceptance tests (section 3.6): the Gherkin scenarios of the user stories and of the
    non-functional requirements run with Reqnroll against the real HTTP APIs of the microservices.
    By default every API is hosted in memory with WebApplicationFactory (no containers, no external
    services). When ACCEPTANCE_BASE_URL is set the same scenarios run against a deployed environment
    through its API gateway; those tagged @solo-en-memoria are skipped there.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>MineSenseSafety.AcceptanceTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.11" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="8.10.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="Reqnroll.xUnit" Version="2.2.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Every web project declares a global Program class; the aliases keep them apart. -->
  <ItemGroup>
    <ProjectReference Include="..\..\FatigueDetectionService\FatigueDetectionService.csproj" Aliases="fatigue" />
    <ProjectReference Include="..\..\AlertService\AlertService.csproj" Aliases="alerts" />
    <ProjectReference Include="..\..\IdentityAccessService\IdentityAccessService.csproj" Aliases="identity" />
    <ProjectReference Include="..\..\OperationsService\OperationsService.csproj" Aliases="operations" />
    <ProjectReference Include="..\..\DeviceManagementService\DeviceManagementService.csproj" Aliases="devices" />
    <ProjectReference Include="..\..\MonitoringService\MonitoringService.csproj" Aliases="monitoring" />
    <ProjectReference Include="..\..\FleetMonitoringService\FleetMonitoringService.csproj" Aliases="fleet" />
    <ProjectReference Include="..\..\IncidentManagementService\IncidentManagementService.csproj" Aliases="incidents" />
    <ProjectReference Include="..\..\AnalyticsService\AnalyticsService.csproj" Aliases="analytics" />
    <ProjectReference Include="..\..\FeedbackReliabilityService\FeedbackReliabilityService.csproj" Aliases="feedback" />
    <ProjectReference Include="..\..\PrivacyAuditService\PrivacyAuditService.csproj" Aliases="privacy" />
    <ProjectReference Include="..\..\ReportingService\ReportingService.csproj" Aliases="reporting" />
    <ProjectReference Include="..\..\EdgeSynchronizationService\EdgeSynchronizationService.csproj" Aliases="edgesync" />
  </ItemGroup>

</Project>
