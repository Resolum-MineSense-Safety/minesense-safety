# Base URLs of the MineSense Safety REST services.
# Defaults point to the Vite dev proxy prefixes (see vite.config.js).
# Override them with absolute URLs (e.g. http://localhost:5255) when the
# backend serves the API from another origin with CORS enabled.
VITE_IAM_API_URL=/iam
VITE_FATIGUE_API_URL=/fatigue
VITE_ALERTS_API_URL=/alerts
VITE_FLEET_API_URL=/fleet
VITE_INCIDENTS_API_URL=/incidents
