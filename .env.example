# Copy to .env to override the defaults of docker-compose.yml (local development only).
POSTGRES_USER=admin
POSTGRES_PASSWORD=minesense-local

# Monitoring asks Device Management for pre-shift availability.
MONITORING_DEVICE_SERVICE_URL=http://device-management-service:8080/

# Feedback & Reliability: OIDC authority (empty in Development) and Alerts URL.
FEEDBACK_AUTHORITY=
FEEDBACK_ALERT_SERVICE_URL=http://alert-service:8080/
