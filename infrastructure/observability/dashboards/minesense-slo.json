    },
    {
      "id": 4,
      "title": "Servicios arriba",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Targets que Prometheus raspa con éxito.",
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 5
